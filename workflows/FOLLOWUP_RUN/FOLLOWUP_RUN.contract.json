{
  "flow": "FOLLOWUP_RUN",
  "covers": [
    "R8",
    "R9",
    "R17",
    "R22"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "pucho-whatsapp",
    "schedule",
    "webhook"
  ],
  "allow_names": [
    "cron_expression",
    "return_response",
    "send_request",
    "send_template_message"
  ],
  "require_capabilities": [
    "schedule=schedule:trigger",
    "respond=webhook:respond",
    "open=step_open:http:write",
    "nudge=step_nudge:pucho-whatsapp:write",
    "count=step_nudge_patch:http:write",
    "status=step_status:http:write",
    "log=step_run:http:write"
  ],
  "unverified_outputs": [],
  "custom": true
}